# ── Asosiy ──
# PostgreSQL ulanishi (pg_trgm kengaytmasi kerak; migratsiya uni o‘zi yaratadi)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/ozbegim?schema=public"
# Better Auth: kamida 32 belgili tasodifiy qiymat (masalan: openssl rand -base64 32)
BETTER_AUTH_SECRET=""
# Saytning to‘liq manzili (CSRF/Origin tekshiruvi uchun ham ishlatiladi)
BETTER_AUTH_URL="http://localhost:3000"
# Qo‘shimcha ishonchli manzillar (vergul bilan), ixtiyoriy
TRUSTED_ORIGINS=""
# Reverse proxy ortida bo‘lsa "true" (X-Forwarded-For dan IP olinadi)
TRUST_PROXY="false"

# ── Rate limit ──
AUTH_SIGNUP_PER_HOUR="5"
AUTH_SIGNIN_PER_MINUTE="5"
# "off" — faqat mahalliy sinov uchun
AUTH_RATE_LIMIT="on"
APP_RATE_LIMIT="on"

# ── Fayllar ──
# local — server diskidagi yopiq papka; s3 — S3 bilan mos obyekt saqlash xizmati
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./.data/storage"
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Vaqtinchalik fayllar saqlanish muddati (soat)
FILE_RETENTION_HOURS="24"
# Bitta fayl hajmi chegarasi (MB)
FILE_MAX_MB="20"
# inline — fayl yuklangan zahoti shu jarayonda ishlanadi; worker — alohida "npm run worker"
FILE_PROCESSING="worker"

# ── Tashqi xizmatlar (ixtiyoriy) ──
# AI tavsiyalari (Anthropic Claude API). Bo‘sh bo‘lsa — "Xizmat ulanmagan".
ANTHROPIC_API_KEY=""
AI_MODEL="claude-opus-5-5"
# OCR: "tesseract" (serverda tesseract-ocr o‘rnatilgan bo‘lsa) yoki bo‘sh
OCR_PROVIDER=""
TESSERACT_PATH="tesseract"
TESSERACT_LANGS="uzb+uzb_cyrl"
# Transkripsiya xizmati hozircha ulanmagan (README’ga qarang)
TRANSCRIPTION_PROVIDER=""

# ── Testlar ──
TEST_BASE_URL="http://localhost:3000"
